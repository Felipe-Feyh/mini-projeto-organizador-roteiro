# ===========================================
# Configuração do Organizador de Roteiros
# ===========================================

# Provedor LLM (groq ou openai)
LLM_PROVIDER=groq

# Groq (gratuito - https://console.groq.com/keys)
GROQ_API_KEY=gsk_sua-chave-groq-aqui
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (alternativa - requer pagamento)
OPENAI_API_KEY=sk-sua-chave-aqui
OPENAI_MODEL=gpt-4o-mini

# API de Clima (OpenWeatherMap - https://openweathermap.org/api)
OPENWEATHER_API_KEY=sua-chave-openweather-aqui

# Configurações da aplicação
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_MAX_RETRIES=3
APP_TIMEOUT_SECONDS=10

# Webhook para integração low-code (n8n/Make)
WEBHOOK_URL=https://seu-webhook-url-aqui

# Discord (opcional - ChatOps)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/seu-webhook
